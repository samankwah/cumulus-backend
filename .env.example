# Runtime configuration for the Cumulus backend.
# Reference only: the app reads the process environment, not this file. Set these in your shell
# or in the Vercel project settings. Unset paths default to this repo.

# Directory holding the runtime YAML config (base.yaml, model.yaml, advisory.yaml, seasonal_map.yaml).
CUMULUS_CONFIG_DIR=configs

# Root directory for ML data (raw inputs under data/raw, processed datasets under
# data/processed). Created on first run if missing.
CUMULUS_DATA_DIR=data

# Where nationwide advisory run artifacts are written.
CUMULUS_NATIONWIDE__ARTIFACT_DIR=data/artifacts/nationwide

# Excel workbook with in-situ station rainfall, used only by POST /train.
# Drop the file at this path (under CUMULUS_DATA_DIR/raw/stations/) before training.
CUMULUS_DEFAULT_STATION_PATH=data/raw/stations/Rainfall_data.xlsx

# Optional: extra browser origins allowed by CORS, comma-separated. The localhost
# dev origins and the deployed frontend are always allowed.
# CUMULUS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sub-seasonal IFS-UNet ingest (offline, `python -m cumulus.subseasonal.ingest`).
# Container SAS URL with Read + List permission. Never commit the real value.
# CUMULUS_SUBSEASONAL__AZURE_SAS_URL=https://<account>.blob.core.windows.net/<container>?<sas-token>
# CUMULUS_SUBSEASONAL__AZURE_PREFIX=Unet/
# CUMULUS_SUBSEASONAL__LOCAL_SOURCE_DIR=D:/data/Unet

# Admin endpoints (POST /forecast/products/refresh, GET /health/details, legacy generate/train)
# need this key in the X-API-Key header. Unset = those endpoints return 404.
# CUMULUS_ADMIN_API_KEY=<long-random-string>
# Local development only: open the admin endpoints without a key.
# CUMULUS_ALLOW_UNAUTHENTICATED_ADMIN=true
# Re-enable the retired random-forest/ERA5 endpoints (/predict, /advisory, /forecast, /train, ...).
# CUMULUS_ENABLE_LEGACY_ENDPOINTS=true
